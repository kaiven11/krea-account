# ===== Nopecha（当前服务商） =====
NOPECHA_API_KEY=YOUR_NOPECHA_KEY

# ===== 账号批量 =====
EMAIL_DOMAIN=cmzw.cloud
EMAIL_PREFIX=reg
KREA_PASSWORD=Aa@123456789
ACCOUNT_COUNT=1

# ===== 邮箱验证码（QQ IMAP IDLE 实时收） =====
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=your_qq@example.com
IMAP_PASS=YOUR_QQ_APP_PASSWORD

# ===== Clash 代理轮换 =====
PROXY_MODE=clash
CLASH_API=http://127.0.0.1:9090
CLASH_SECRET=
CLASH_SOCKS5_PORT=7891
CLASH_GROUP=GLOBAL

# ===== 浏览器 =====
HEADLESS=false
